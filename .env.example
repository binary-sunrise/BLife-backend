# ==============================================================================
# B-Liffe FastAPI Backend - Production Configuration Template
# ==============================================================================

# Application Runtime
ENVIRONMENT=production
APP_NAME="B-Liffe Biodiversity Field Data API"
SERVICE_NAME="b-liffe-backend"
APP_VERSION="2.0.0"

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS & Client URLs (Allow CloudFront frontend and local dev)
FRONTEND_URL=https://d3lallddukllru.cloudfront.net
ALLOWED_ORIGINS=https://d3lallddukllru.cloudfront.net,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false

# ==============================================================================
# Database Configuration - AWS RDS PostgreSQL (asyncpg + SQLAlchemy)
# ==============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:your_password@blife-db-prod.cxags06gwym1.ap-southeast-2.rds.amazonaws.com:5432/blife_db"
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
RDS_CA_BUNDLE_PATH=certs/global-bundle.pem

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ==============================================================================
# Storage - Amazon S3 (Observations, photos, and attachments)
# ==============================================================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET=blife-media-prod-042396229463
# In AWS production, leave empty to automatically assume EC2 IAM Instance Profile.
# Set only for local offline development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional S3 Custom Domain or CDN prefix (e.g. https://media.yourdomain.org)
# AWS_S3_PUBLIC_URL_PREFIX=
# AWS_S3_ENDPOINT_URL=

# ==============================================================================
# Authentication & Security
# ==============================================================================
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here!
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_MIN_PASSWORD_LENGTH=6

# Background Tasks (Optional)
REDIS_URL="redis://localhost:6379/0"
