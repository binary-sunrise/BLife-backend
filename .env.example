# ==============================================================================
# B-Liffe FastAPI Backend - Production Configuration Template
# ==============================================================================

# Application & Environment
ENVIRONMENT=production
APP_NAME="B-Liffe Biodiversity Field Data API"
SERVICE_NAME="b-liffe-backend"
APP_VERSION="2.0.0"

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS & Client URLs (Allow CloudFront frontend and local dev)
FRONTEND_URL=https://d2msowv3rhnqjt.cloudfront.net
ALLOWED_ORIGINS=https://d2msowv3rhnqjt.cloudfront.net,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false

# ==============================================================================
# Database Configuration - AWS RDS PostgreSQL (asyncpg + SQLAlchemy)
# ==============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:your_password@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/bliffe_db"
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
RDS_CA_BUNDLE_PATH=certs/global-bundle.pem

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ==============================================================================
# Authentication & Security
# ==============================================================================
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here!
BETTER_AUTH_URL=http://bliffe-api.ap-southeast-2.elasticbeanstalk.com
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_MIN_PASSWORD_LENGTH=6

# ==============================================================================
# AWS S3 Storage Configuration
# ==============================================================================
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=bliffe-media
# In Elastic Beanstalk, EC2 IAM profile supplies credentials automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
