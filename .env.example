# ==============================================================================
# B-Liffe FastAPI Backend - Environment Configuration Template
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
APP_NAME="B-Liffe Biodiversity Field Data API"
SERVICE_NAME="b-liffe-backend"
APP_VERSION="2.0.0"

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS & Client URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=false

# ==============================================================================
# Database Configuration - AWS RDS PostgreSQL (asyncpg + SQLAlchemy)
# ==============================================================================
# Async Connection URL (PostgreSQL + asyncpg with SSL)
DATABASE_URL="postgresql+asyncpg://postgres:your_secure_password@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/bliffe_db"

# Database SSL & Security Settings
# AWS RDS requires SSL.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
RDS_CA_BUNDLE_PATH=certs/global-bundle.pem

# Connection Pool Tuning for RDS Free Tier (db.t3.micro / db.t4g.micro with 1GB RAM)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ==============================================================================
# Background Tasks (ARQ + Redis)
# ==============================================================================
REDIS_URL="redis://localhost:6379/0"

# ==============================================================================
# Authentication & Security
# ==============================================================================
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_key_here!
BETTER_AUTH_URL=http://localhost:3000
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
AUTH_MIN_PASSWORD_LENGTH=6

# Optional OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Amazon S3 / Object Storage Configuration (Free Tier)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bliffe-media
# Optional CDN / CloudFront prefix (e.g. https://media.b-liffe.org)
AWS_S3_PUBLIC_URL_PREFIX=
# Optional custom S3-compatible endpoint (e.g. MinIO, LocalStack, Cloudflare R2)
AWS_S3_ENDPOINT_URL=
